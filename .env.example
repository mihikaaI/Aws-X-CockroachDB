# --- CockroachDB ---
# CockroachDB Cloud (recommended for the hackathon) or self-hosted / local docker-compose
DATABASE_URL="postgresql://kshitij:<tUaPass>@agentops-cluster-31569.j77.aws-ap-south-1.cockroachlabs.cloud:26257/agentops?sslmode=verify-full"

# --- LLM reasoning backend: choose ONE ---
# Option A: Amazon Bedrock (counts as extra AWS usage for judging)
LLM_BACKEND=bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0
# ^ check the exact current model ID string in your Bedrock console -> Model access

# Option B: Anthropic API directly (simpler to set up, same reasoning quality)
# LLM_BACKEND=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# --- AWS ECS target (the application AgentOps is watching over) ---
ECS_CLUSTER_NAME=agentops-demo-cluster
ECS_SERVICE_NAME=agentops-demo-service
CPU_SCALE_THRESHOLD=75.0

# --- Agent thresholds ---
LATENCY_THRESHOLD_MS=300
SEED_NUM_ORDERS=200000
