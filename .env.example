# ============================================================
# AgentOps configuration. Copy to .env and fill in.
#   cp .env.example .env
#
# Never commit a filled-in .env -- it holds real credentials. .env is
# gitignored; only this .env.example template belongs in git.
# ============================================================

# --- CockroachDB (required) ---------------------------------
# CockroachDB Cloud serverless (supports vector indexes) or a local cluster.
# Local:  postgresql://root@localhost:26257/agentops?sslmode=disable
DATABASE_URL=your_key_here


# Connection pool sizing (see tools/crdb_client.py). Raise DB_POOL_MAX if you
# run load_generator with many workers.
DB_POOL_MIN=1
DB_POOL_MAX=24

# --- LLM backend --------------------------------------------

# Change backend to gemini
LLM_BACKEND=gemini

# Paste your Gemini key here
GEMINI_API_KEY=your_key_here

# (Optional) Model name
GEMINI_MODEL=gemini-3.6-flash


# If LLM_BACKEND=anthropic:
ANTHROPIC_API_KEY=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

# If LLM_BACKEND=bedrock:
BEDROCK_MODEL_ID=
# ^ check the exact current model ID string in your Bedrock console -> Model access

# LLM resilience (tools/llm.py)
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3

# --- Incident detection / diagnosis -------------------------
# Latency (ms) above which the monitor flags an incident.
LATENCY_THRESHOLD_MS=300
# Distance below which a recalled incident is treated as "seen before" and the
# LLM is skipped entirely (the self-improving short-circuit).
MEMORY_MATCH_MAX_DISTANCE=0.05

# --- Guardrails ---------------------------------------------
# Propose fixes but never execute them (safe demo / staging).
DRY_RUN=
# Auto-apply a fix only at/above this confidence; below it, hold for a human.
AUTO_APPLY_MIN_CONFIDENCE=0.6
# Keep an applied index only if it improves latency by at least this fraction;
# otherwise roll it back.
MIN_IMPROVEMENT_RATIO=0.10

# --- AWS (optional; stubs no-op gracefully if unset) --------
AWS_REGION=us-east-1
ECS_CLUSTER_NAME=
ECS_SERVICE_NAME=
CPU_SCALE_THRESHOLD=75.0

# --- Seeding / demo -----------------------------------------
SEED_NUM_ORDERS=200000

# --- Dashboard ----------------------------------------------
DASHBOARD_PORT=8888
